# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# test coverage output
coverage/

# build output (static export)
out/

# deploy artifacts
*.zip

# playwright mcp scratch
.playwright-mcp/

# Design references (kept local, never published)
# Contains third-party app screenshots and Instagram stories showing another
# person's photo and handle. Republishing them would be a privacy and
# copyright problem, and they are 59MB of binaries the build does not need.
referensi/
